# Circular — ortam değişkenleri örneği
# Bu dosyayı `.env` olarak kopyalayın. `.env` git'e eklenmez.

# Veritabanı (Postgres). Yerelde: postgresql://<kullanici>@localhost:5432/circular_dev
# Sunucusuz ortamda (ör. Vercel) sağlayıcının "pooled" bağlantı adresini kullanın.
DATABASE_URL="postgresql://kullanici:sifre@host:5432/circular"

# Uygulamanın dışarıdan erişilen adresi. QR kodların içindeki bağlantılar bu adresle üretilir;
# telefonla okutulacaksa telefonun erişebildiği adres olmalıdır (localhost telefonda açılmaz).
# Migration'lar için doğrudan (havuzsuz) bağlantı. Yerelde DATABASE_URL ile aynıdır;
# Neon/Vercel kurulumunda otomatik tanımlanır.
DATABASE_URL_UNPOOLED="postgresql://kullanici:sifre@host:5432/circular"

APP_BASE_URL="http://localhost:3000"

# Kişiye özel QR token'larının türetildiği gizli anahtar (en az 32 karakter).
# Üretmek için: openssl rand -base64 48
# Değiştirilirse daha önce verilmiş tüm QR kodlar geçersiz olur.
PASS_TOKEN_SECRET="degistir-bunu-en-az-32-karakterlik-rastgele-bir-degerle"

# Demo seed kullanıcılarının ortak şifresi. Yalnızca yerel demo içindir;
# gerçek ortamda seed çalıştırmayın.
SEED_DEMO_PASSWORD="demo-sifre-degistir"

# Giriş ekranında demo hesap e-postalarını listeler (şifre gösterilmez).
# Gerçek ortamda "false" yapın veya silin.
SHOW_DEMO_ACCOUNTS="true"

# ─── Kampanyalar · WhatsApp
# Kanal erişim token'larını şifreleyen anahtar (en az 32 karakter). Üretmek için: openssl rand -base64 48
# Değiştirilirse bağlı WhatsApp numaralarının yeniden bağlanması gerekir.
CHANNEL_TOKEN_SECRET="degistir-bunu-en-az-32-karakterlik-rastgele-bir-degerle"

# Circular'ın Meta uygulaması (Meta işletme doğrulaması + uygulama incelemesi + Tech Provider kurulumu sonrası).
# Boş bırakılırsa "WhatsApp numarasını bağla" düğmesi görünmez.
META_APP_ID=""
META_APP_SECRET=""
# Embedded Signup yapılandırma kimliği (Meta uygulama paneli › WhatsApp › Embedded Signup)
WHATSAPP_ES_CONFIG_ID=""
# Meta'nın webhook doğrulamasında kullanılacak, sizin belirlediğiniz rastgele değer
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# META_GRAPH_VERSION="v26.0"

# Geliştirme: Meta'nın test numarasını kimlik ve geçici token ile elle bağlamaya izin verir. Canlı ortamda "false".
WHATSAPP_MANUAL_CONNECT="false"

# ─── Kampanyalar · SMS (Netgsm)
# İşletmeler kendi Netgsm (alt) hesaplarını panelden bağlar; burada ek ayar gerekmez.

# ─── Kampanyalar · E-posta (Brevo)
# Circular'ın Brevo hesabı. Gönderici adres, Brevo'da doğrulanmış alan adında olmalı (SPF, DKIM, DMARC).
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
# Brevo webhook'unda "Authorization: Bearer <değer>" olarak girilecek rastgele anahtar
BREVO_WEBHOOK_TOKEN=""

# ─── Instagram · DM otomasyonu (Instagram API, Instagram girişi)
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
# Meta'nın Instagram webhook doğrulamasında kullanılacak, sizin belirlediğiniz rastgele değer
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=""
# Geliştirme: uygulama panelinden alınan token ile elle bağlama. Canlı ortamda "false".
INSTAGRAM_MANUAL_CONNECT="false"


# ─── AI Asistan · dil modeli (Groq — OpenAI uyumlu uç nokta)
# https://console.groq.com › API Keys. Ücretsiz katman kredi kartı istemez.
# Boş bırakılırsa asistan çalışmaya devam eder, yalnızca anahtar kelime moduna düşer.
GROQ_API_KEY=""
# ASSISTANT_MODEL="openai/gpt-oss-120b"
# Cevap cümlesini de modelin yazmasını kapatmak için "false" (sayılar yine panelden gelir)
# ASSISTANT_MODEL_PHRASING="true"
